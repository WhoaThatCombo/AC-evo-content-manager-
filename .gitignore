# --- user data and machine-specific state -----------------------------------
# Profiles, logs, runtime pids. Never someone else's business.
data/
config.json

# ⚠ NEVER COMMIT THESE ---------------------------------------------------------
# Protobuf descriptors are extracted from the user's OWN game binary at runtime
# (see acecm/protos.py). They are derived from Kunos' executable, so they are
# not ours to redistribute.
**/protos/
*.desc

# TLS keys are generated per machine. A private key in a public repo is the
# same key for every user, which is no security at all.
**/certs/
*.pem
*.key

# Game/server binaries and content. This project manages an install; it does
# not ship one.
*.kspkg
# ⚠ Kunos .table files. Two of these (input_action_sorting,
# input_axis_sorting) were tracked here and shipped inside the exe until
# 1.0.0, referenced by nothing. This repo manages an install; it does not
# hold one.
tools/system/
AssettoCorsaEVOServer*.exe
AssettoCorsaEVO.exe

# --- build output -------------------------------------------------------------
dist/
dist-native/
build_tmp/
*.spec
ACECM.version
__pycache__/
*.pyc

# --- scratch ------------------------------------------------------------------
*.tmp
*.bak
# ⚠ `*.bak` does NOT catch these: a suffixed backup like
# app.js.bak_carpolicy is a different name, and three of them very
# nearly went into a release commit.
*.bak_*
*.log
# ⚠ tools/evoview.exe is COMMITTED, like every other tool. It is built
# separately with cargo from a checkout that is not in this repo, so a CI
# runner cannot produce it - and build.py only warns when it is absent,
# which would publish a release with the 3D viewer silently missing.
verify_out/

# stray copy - the shipped viewer is staged into tools/ by build.py
acecm/tools/

# --- the old Python app: kept on the author's disk, not in the repo ----------
# Windows ships the native app (native/). The Python app is what Linux 1.0.21
# was built from; it stays local until Linux is ported. Only what the native
# build and the release tools still use is tracked: the web UI and version.py
# (release_sign / publish_release import its signature check).
acecm/*.py
!acecm/version.py
launcher.py
acecm_sync.py
run.bat
requirements.txt
requirements-linux.txt
setup-linux.sh
tools/*.py
!tools/release_sign.py
!tools/publish_release.py
tools/gencert.sh
tools/srv_nodamage_revert.json
native/tools/*.py
